# Novel Studio - LLM Configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.

# ---- LLM ----
LLM_API_FORMAT=openai_compat        # 'openai_compat' or 'ollama'
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Embedding (optional, falls back to LLM config if empty) ----
EMBEDDING_API_FORMAT=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
