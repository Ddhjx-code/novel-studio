# 本地开发配置模板。复制为 .env.local 后填入真实值（.env.local 已 gitignored）。
# spike 脚本和后端启动时会自动加载 .env.local。

# ---- LLM ----
# Zenmux 同时提供两个端点，二选一：
#   OpenAI 兼容协议:   https://zenmux.ai/api/v1
#   Anthropic 协议:    https://zenmux.ai/api/anthropic
LLM_API_FORMAT=openai_compat        # 'openai_compat' 或 'anthropic'
LLM_BASE_URL=https://zenmux.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Embedding ----
# 不填则 fallback 到上面的 LLM 配置
EMBEDDING_API_FORMAT=              # 'openai_compat' 或 'ollama'，空则跟随 LLM_API_FORMAT
EMBEDDING_BASE_URL=                # 空则跟随 LLM_BASE_URL
EMBEDDING_MODEL=                   # 空则默认 text-embedding-3-small
EMBEDDING_API_KEY=                 # 空则跟随 LLM_API_KEY
